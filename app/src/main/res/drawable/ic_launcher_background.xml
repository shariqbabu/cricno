<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Obsidian Dark Slate Background -->
    <path
        android:pathData="M 0,0 L 108,0 L 108,108 L 0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#181B28" />
                <item android:offset="0.5" android:color="#0F111A" />
                <item android:offset="1.0" android:color="#06070A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient Crimson Glow in Center -->
    <path
        android:pathData="M 54,18 A 36,36 0 1,0 54,90 A 36,36 0 1,0 54,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="36">
                <item android:offset="0.0" android:color="#4DFF1E39" />
                <item android:offset="0.6" android:color="#1AFF1E39" />
                <item android:offset="1.0" android:color="#0007080B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Cinematic Diagonal Glass Accent Line -->
    <path
        android:pathData="M 0,18 L 108,72 L 108,76 L 0,22 Z"
        android:fillColor="#0DFFFFFF" />

</vector>
