<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Outer Soft Glow Shadow for Cinema Ring -->
    <path
        android:pathData="M 76,34 A 28,28 0 1,0 76,74"
        android:strokeColor="#55FF1E39"
        android:strokeLineCap="round"
        android:strokeWidth="15" />

    <!-- 2. Main 3D CineFlix "C" Cinema Ring with Gradient -->
    <path
        android:pathData="M 76,34 A 28,28 0 1,0 76,74"
        android:strokeLineCap="round"
        android:strokeWidth="11">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="26"
                android:startY="30"
                android:endX="76"
                android:endY="78">
                <item android:offset="0.0" android:color="#00D2FF" />
                <item android:offset="0.25" android:color="#FF2A55" />
                <item android:offset="0.65" android:color="#FF1E39" />
                <item android:offset="1.0" android:color="#C80610" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Inner Highlight Bevel Arc -->
    <path
        android:pathData="M 72,34 A 24,24 0 0,0 36,44"
        android:strokeColor="#66FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2.5" />

    <!-- 4. Soft Shadow behind Play Triangle -->
    <path
        android:fillColor="#80000000"
        android:pathData="M 48,42 C 48,40 50.2,38.8 52,39.9 L 69.5,52.4 C 71.2,53.5 71.2,55.5 69.5,56.6 L 52,69.1 C 50.2,70.2 48,69 48,67 Z" />

    <!-- 5. Center Gleaming Pure White Play Button -->
    <path
        android:pathData="M 47,40.5 C 47,38.8 48.9,37.8 50.4,38.8 L 68,51.8 C 69.4,52.8 69.4,54.8 68,55.8 L 50.4,68.8 C 48.9,69.8 47,68.8 47,67.1 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="47"
                android:startY="38"
                android:endX="69"
                android:endY="69">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.7" android:color="#F0F4FF" />
                <item android:offset="1.0" android:color="#D0D8E8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. Play Button Top Glass Reflection -->
    <path
        android:fillColor="#80FFFFFF"
        android:pathData="M 47.5,41 C 47.5,39.5 49,38.6 50.3,39.5 L 67,52.5 L 47.5,52.5 Z" />

</vector>
